<Window x:Class="CordollaPDF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:CordollaPDF.Behaviors"
        xmlns:models="clr-namespace:CordollaPDF.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="{Binding WindowCaption}"
        Icon="Assets/app_icon.ico"
        Width="1600"
        Height="980"
        MinWidth="1200"
        MinHeight="760"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStyle="None"
        SizeChanged="Window_OnSizeChanged"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        PreviewKeyUp="Window_OnPreviewKeyUp"
        PreviewMouseWheel="Window_OnPreviewMouseWheel"
        Deactivated="Window_OnDeactivated" AllowsTransparency="True">
        <shell:WindowChrome.WindowChrome>
            <shell:WindowChrome CaptionHeight="42"
                                CornerRadius="10"
                                GlassFrameThickness="0"
                                NonClientFrameEdges="None"
                                ResizeBorderThickness="6"
                                UseAeroCaptionButtons="True" />
        </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate />
                </Setter.Value>
            </Setter>
        </Style>

        <SolidColorBrush x:Key="TitleBrush" Color="#343434" />
        <SolidColorBrush x:Key="ChromeBrush" Color="#2A2A2A" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#343434" />
        <SolidColorBrush x:Key="ViewerBrush" Color="#343434" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#454545" />
        <SolidColorBrush x:Key="WindowOutlineBrush" Color="#565656" />
        <SolidColorBrush x:Key="AccentBrush" Color="#F28C38" />
        <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F19884" Offset="0" />
            <GradientStop Color="#EEA97A" Offset="0.45" />
            <GradientStop Color="#F0C06A" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#B8B8B8" />
        <SolidColorBrush x:Key="StrongTextBrush" Color="#D9D9D9" />
        <SolidColorBrush x:Key="MenuPopupBrush" Color="#2F2F2F" />
        <SolidColorBrush x:Key="MenuPopupBorderBrush" Color="#545454" />
        <SolidColorBrush x:Key="MenuHoverBrush" Color="#454545" />
        <SolidColorBrush x:Key="MenuTopHoverBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="MenuTopSelectedBrush" Color="#404040" />
        <SolidColorBrush x:Key="ContextMenuBrush" Color="#2C2C2C" />
        <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#505050" />
        <SolidColorBrush x:Key="ContextMenuHoverBrush" Color="#3D3D3D" />
        <SolidColorBrush x:Key="OutlineSelectionBrush" Color="#4A4A4A" />
        <SolidColorBrush x:Key="OutlineSelectionBorderBrush" Color="#6A6A6A" />
        <SolidColorBrush x:Key="ScrollTrackBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#6B6B6B" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#848484" />
        <SolidColorBrush x:Key="FindPanelBrush" Color="#2F2F2F" />
        <SolidColorBrush x:Key="FindPanelBorderBrush" Color="#565656" />

        <Style x:Key="MenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                        Margin="0"
                        Background="#4A4A4A"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectionContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource ContextMenuBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ContextMenuBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectionContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource ContextMenuHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#7F7F7F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <Grid MinWidth="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=MinWidth}">
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Bottom"
                                       PopupAnimation="Fade">
                                    <Border Margin="0,6,0,0"
                                            Padding="4"
                                            MinWidth="140"
                                            Background="{StaticResource MenuPopupBrush}"
                                            BorderBrush="{StaticResource MenuPopupBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="0">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>

                                <Grid x:Name="HeaderLayoutGrid"
                                      Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter x:Name="HeaderHost"
                                                      Margin="0"
                                                      VerticalAlignment="Center"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True" />

                                    <Path x:Name="Arrow"
                                          Grid.Column="1"
                                          Margin="14,0,0,0"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 6 0 L 3 4 Z"
                                          Fill="{StaticResource MutedTextBrush}"
                                          Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="RootBorder" Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="22,10" />
                                <Setter Property="Margin" Value="0,0,14,0" />
                                <Setter Property="FontSize" Value="15" />
                                <Setter TargetName="HeaderLayoutGrid" Property="Margin" Value="0" />
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="RootBorder" Property="Background" Value="Transparent" />
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Right" />
                                <Setter Property="Padding" Value="14,9" />
                                <Setter Property="FontSize" Value="15" />
                                <Setter TargetName="HeaderLayoutGrid" Property="Margin" Value="11,3,0,3" />
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Right" />
                                <Setter Property="Padding" Value="14,9" />
                                <Setter Property="FontSize" Value="15" />
                                <Setter TargetName="HeaderLayoutGrid" Property="Margin" Value="11,3,0,3" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource MenuHoverBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Role" Value="TopLevelHeader" />
                                    <Condition Property="IsHighlighted" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource MenuTopHoverBrush}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Role" Value="TopLevelHeader" />
                                    <Condition Property="IsSubmenuOpen" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource MenuTopSelectedBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#7F7F7F" />
                                <Setter TargetName="Arrow" Property="Fill" Value="#7F7F7F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
            <Setter Property="Background" Value="#313131" />
            <Setter Property="BorderBrush" Value="#565656" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D3D3D" />
                    <Setter Property="BorderBrush" Value="#6C6C6C" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#4B4B4B" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ChromeButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style x:Key="PrimaryToolButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ChromeButtonStyle}">
            <Setter Property="Width" Value="88" />
        </Style>

        <Style x:Key="PageIndexTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
            <Setter Property="Background" Value="#2E2E2E" />
            <Setter Property="BorderBrush" Value="#575757" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FindTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource PageIndexTextBoxStyle}">
            <Setter Property="Background" Value="#383838" />
            <Setter Property="BorderBrush" Value="#5C5C5C" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="6,0"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FindCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3B3B3B" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#4A4A4A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseCaptionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#A52619" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="Expander"
                                          Grid.Row="0"
                                          Grid.Column="0"
                                          Width="16"
                                          Height="16"
                                          Margin="0,3,4,0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Visibility="Hidden">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent">
                                                        <Path x:Name="Arrow"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Data="M 0 0 L 6 0 L 3 4 Z"
                                                              Fill="{StaticResource MutedTextBrush}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="180" CenterX="3" CenterY="2" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.85" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <Border x:Name="SelectionBorder"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,0,10,0"
                                    Padding="8,4"
                                    CornerRadius="7"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    BorderBrush="Transparent"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="12,2,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Expander" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionBorder" Property="Background" Value="{StaticResource OutlineSelectionBrush}" />
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource OutlineSelectionBorderBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsSelectionActive" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SelectionBorder" Property="Opacity" Value="0.9" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="{StaticResource ScrollTrackBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="{StaticResource ScrollThumbBrush}">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Margin="1"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="8" />
                                <Setter Property="Width" Value="Auto" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}" />

        <Style TargetType="Thumb">
            <Setter Property="Background" Value="{StaticResource ScrollThumbBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ScrollThumbHoverBrush}" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Background" Value="{StaticResource ScrollThumbHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type models:OutlineItem}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Title}"
                       Foreground="{StaticResource StrongTextBrush}"
                       FontSize="14"
                       TextWrapping="Wrap" />
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Border x:Name="WindowFrameBorder"
            Background="Transparent"
            BorderBrush="{StaticResource WindowOutlineBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border x:Name="WindowContentBorder"
                BorderBrush="#262626"
                BorderThickness="1"
                Background="{StaticResource ViewerBrush}"
                CornerRadius="9">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="9" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter Property="CornerRadius" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel Background="Transparent">
                <Grid DockPanel.Dock="Top"
                  Height="42"
                  MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="138" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                           Margin="18,0,18,0"
                           VerticalAlignment="Center"
                           FontSize="15"
                           Foreground="{DynamicResource BrandGradientBrush}"
                           Text="CordollaPDF" />

                    <Menu Grid.Column="1"
                      VerticalAlignment="Center"
                      Background="Transparent">
                        <MenuItem Header="_File">
                            <MenuItem Header="_Open" Click="OpenMenuItem_OnClick" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                            <MenuItem Header="Jump To _Top" Click="JumpToTopMenuItem_OnClick" />
                            <MenuItem Header="Jump To _Bottom" Click="JumpToBottomMenuItem_OnClick" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                            <MenuItem Header="_Close" Click="CloseMenuItem_OnClick" />
                            <MenuItem Header="E_xit" Click="ExitMenuItem_OnClick" />
                        </MenuItem>
                        <MenuItem Header="_Edit">
                            <MenuItem Header="Fit To Screen" Click="FitButton_OnClick" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                            <MenuItem Header="Toggle Two-Page Mode" Click="TogglePageModeMenuItem_OnClick" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                            <MenuItem Header="{Binding TableOfContentsMenuText}" Click="ToggleTableOfContentsMenuItem_OnClick" />
                        </MenuItem>
                        <MenuItem Header="_Help">
                            <MenuItem Header="_Manual" Click="ManualMenuItem_OnClick" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                            <MenuItem Header="Send feedback" Click="AboutMenuItem_OnClick" />
                        </MenuItem>
                    </Menu>

                    <Grid Grid.ColumnSpan="5"
                          IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding SidebarColumnWidth}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="15"
                                   Text="{Binding TitleBarDocumentName}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Grid Grid.Column="3"
                      Margin="0,0,12,0"
                      HorizontalAlignment="Right"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True" />

                    <Grid Grid.Column="4"
                      Margin="0,0,6,0"
                      HorizontalAlignment="Right"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                            Style="{StaticResource CaptionButtonStyle}"
                            Click="MinimizeButton_OnClick"
                            ToolTip="Minimize">
                            <Path Data="M 0 0 L 8 0"
                              Stroke="{StaticResource StrongTextBrush}"
                              StrokeThickness="1.2"
                              Stretch="None" />
                        </Button>

                        <Button Grid.Column="1"
                            Style="{StaticResource CaptionButtonStyle}"
                            Click="MaximizeRestoreButton_OnClick"
                            ToolTip="Maximize">
                            <Grid Width="9" Height="9">
                                <Rectangle x:Name="MaximizeIcon"
                                       Stroke="{StaticResource StrongTextBrush}"
                                       StrokeThickness="1.1" Margin="0,-1,0,1" />
                            </Grid>
                        </Button>

                        <Button Grid.Column="2"
                            Style="{StaticResource CloseCaptionButtonStyle}"
                            Click="CloseCaptionButton_OnClick"
                            ToolTip="Close">
                            <Grid Width="10" Height="10">
                                <Path Data="M 0 0 L 8 8 M 8 0 L 0 8"
                                  Stroke="{StaticResource StrongTextBrush}"
                                  StrokeThickness="1.1"
                                  Stretch="None" />
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding SidebarColumnWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="0"
                        Visibility="{Binding SidebarVisibility}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="18,18,18,10">
                                <TextBlock Foreground="{StaticResource StrongTextBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{Binding SidebarDocumentLabel}" />
                                <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       Text="Table of contents" />
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                    Margin="18,0,18,10"
                                    Orientation="Horizontal">
                                <Button Style="{StaticResource IconButtonStyle}" Content="-" Click="ZoomOutButton_OnClick" />
                                <Button Style="{StaticResource IconButtonStyle}" Content="+" Click="ZoomInButton_OnClick" />
                                <TextBox x:Name="PageNumberTextBox"
                                     Style="{StaticResource PageIndexTextBoxStyle}"
                                     Width="58"
                                     Height="34"
                                     Margin="4,0,6,0"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Center"
                                     Foreground="{StaticResource StrongTextBrush}"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                     KeyDown="PageNumberTextBox_OnKeyDown"
                                     LostKeyboardFocus="PageNumberTextBox_OnLostKeyboardFocus"
                                     Text="{Binding CurrentPage, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Foreground="{StaticResource StrongTextBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="{Binding PageCountText}" />
                                <TextBlock VerticalAlignment="Center"
                                       Foreground="#D8D8D8"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="{Binding ZoomText}" />
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="18,0,18,12">
                                <TreeView x:Name="OutlineTree"
                                      ItemsSource="{Binding OutlineItems}"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.PanningMode="VerticalOnly"
                                      SelectedItemChanged="OutlineTree_OnSelectedItemChanged" />

                                <Border Background="Transparent">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDocument}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Margin="0,12,0,0"
                                           VerticalAlignment="Top"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="13"
                                           Text="" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid>
                            <Border Panel.ZIndex="4"
                                    Width="334"
                                    Margin="0,14,18,0"
                                    Padding="10,10,10,8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource FindPanelBrush}"
                                    BorderBrush="{StaticResource FindPanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Visibility="{Binding IsFindPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBox x:Name="FindTextBox"
                                             Grid.Row="0"
                                             Grid.Column="0"
                                             MinWidth="148"
                                             Margin="0,0,6,0"
                                             Style="{StaticResource FindTextBoxStyle}"
                                             KeyDown="FindTextBox_OnKeyDown"
                                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />

                                    <Button Grid.Row="0"
                                            Grid.Column="1"
                                            Width="52"
                                            Margin="0,0,6,0"
                                            Style="{StaticResource ChromeButtonStyle}"
                                            Click="FindPreviousButton_OnClick"
                                            Content="Prev" />

                                    <Button Grid.Row="0"
                                            Grid.Column="2"
                                            Width="52"
                                            Margin="0,0,6,0"
                                            Style="{StaticResource ChromeButtonStyle}"
                                            Click="FindNextButton_OnClick"
                                            Content="Next" />

                                    <Button Grid.Row="0"
                                            Grid.Column="3"
                                            Margin="0,-6,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource FindCloseButtonStyle}"
                                            Click="CloseFindButton_OnClick"
                                            Content="   x" />

                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="4"
                                               Margin="2,8,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"
                                               Text="{Binding SearchStatusText}" />
                                </Grid>
                            </Border>

                            <StackPanel Panel.ZIndex="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,40"
                                IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDocument}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="18"
                                   Text="Drop a PDF or choose File > Open"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="420" />

                                <TextBlock HorizontalAlignment="Center"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"
                                   Opacity="0.6"
                                   Text="Press the Left/Right to jump in pairs of pages&#x0d;&#x0a;Press Tab to collapse the table of contents"
                                   TextAlignment="Center" />
                            </StackPanel>

                            <ScrollViewer x:Name="ViewerScrollViewer"
                                      Background="{StaticResource ViewerBrush}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      ScrollChanged="ViewerScrollViewer_OnScrollChanged"
                                      SizeChanged="ViewerScrollViewer_OnSizeChanged"
                                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                                      AllowDrop="True"
                                      Drop="ViewerScrollViewer_OnDrop"
                                      Visibility="Visible">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDocument}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>

                                <ItemsControl x:Name="SpreadItemsControl" ItemsSource="{Binding Spreads}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SpreadViewModel}">
                                            <Border Margin="0,15,0,25" HorizontalAlignment="Center">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                        Width="{Binding LeftPage.DisplayWidth}"
                                                        Height="{Binding LeftPage.DisplayHeight}"
                                                        Background="White"
                                                        BorderBrush="#E3E3E3"
                                                        BorderThickness="1"
                                                        SnapsToDevicePixels="True">
                                                        <Grid>
                                                            <Image Source="{Binding LeftPage.Image}"
                                                                   Stretch="Fill"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />

                                                            <Border Background="White">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding LeftPage.Image}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="#9A9A9A"
                                                                           FontSize="18"
                                                                           Text="{Binding LeftPage.PageNumber, StringFormat=Page {0}}" />
                                                            </Border>

                                                            <Canvas Background="Transparent"
                                                                    Tag="{Binding LeftPage}"
                                                                    Cursor="IBeam"
                                                                    ContextMenuOpening="TextSelectionOverlay_OnContextMenuOpening"
                                                                    MouseLeftButtonDown="TextSelectionOverlay_OnMouseLeftButtonDown"
                                                                    MouseMove="TextSelectionOverlay_OnMouseMove"
                                                                    MouseLeftButtonUp="TextSelectionOverlay_OnMouseLeftButtonUp">
                                                                <Canvas.ContextMenu>
                                                                    <ContextMenu Style="{StaticResource SelectionContextMenuStyle}">
                                                                        <MenuItem Header="Copy"
                                                                                  Style="{StaticResource SelectionContextMenuItemStyle}"
                                                                                  Click="CopySelectionMenuItem_OnClick" />
                                                                    </ContextMenu>
                                                                </Canvas.ContextMenu>
                                                                <ItemsControl ItemsSource="{Binding LeftPage.SelectionRects}"
                                                                              IsHitTestVisible="False">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <Canvas />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemContainerStyle>
                                                                        <Style TargetType="ContentPresenter">
                                                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                                        </Style>
                                                                    </ItemsControl.ItemContainerStyle>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type models:TextSelectionRect}">
                                                                            <Rectangle Width="{Binding Width}"
                                                                                       Height="{Binding Height}"
                                                                                       Fill="#6690C8FF" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <ItemsControl ItemsSource="{Binding LeftPage.SearchRects}"
                                                                              IsHitTestVisible="False">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <Canvas />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemContainerStyle>
                                                                        <Style TargetType="ContentPresenter">
                                                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                                        </Style>
                                                                    </ItemsControl.ItemContainerStyle>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type models:TextSelectionRect}">
                                                                            <Rectangle Width="{Binding Width}"
                                                                                       Height="{Binding Height}"
                                                                                       Fill="#66F4D35E" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Canvas>
                                                        </Grid>
                                                    </Border>

                                                    <Border Grid.Column="2"
                                                        Width="{Binding RightPage.DisplayWidth}"
                                                        Height="{Binding RightPage.DisplayHeight}"
                                                        Background="White"
                                                        BorderBrush="#E3E3E3"
                                                        BorderThickness="1"
                                                        Visibility="{Binding HasRightPage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        SnapsToDevicePixels="True">
                                                        <Grid>
                                                            <Image Source="{Binding RightPage.Image}"
                                                                   Stretch="Fill"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />

                                                            <Border Background="White">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RightPage.Image}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="#9A9A9A"
                                                                           FontSize="18"
                                                                           Text="{Binding RightPage.PageNumber, StringFormat=Page {0}}" />
                                                            </Border>

                                                            <Canvas Background="Transparent"
                                                                    Tag="{Binding RightPage}"
                                                                    Cursor="IBeam"
                                                                    Visibility="{Binding HasRightPage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    ContextMenuOpening="TextSelectionOverlay_OnContextMenuOpening"
                                                                    MouseLeftButtonDown="TextSelectionOverlay_OnMouseLeftButtonDown"
                                                                    MouseMove="TextSelectionOverlay_OnMouseMove"
                                                                    MouseLeftButtonUp="TextSelectionOverlay_OnMouseLeftButtonUp">
                                                                <Canvas.ContextMenu>
                                                                    <ContextMenu Style="{StaticResource SelectionContextMenuStyle}">
                                                                        <MenuItem Header="Copy"
                                                                                  Style="{StaticResource SelectionContextMenuItemStyle}"
                                                                                  Click="CopySelectionMenuItem_OnClick" />
                                                                    </ContextMenu>
                                                                </Canvas.ContextMenu>
                                                                <ItemsControl ItemsSource="{Binding RightPage.SelectionRects}"
                                                                              IsHitTestVisible="False">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <Canvas />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemContainerStyle>
                                                                        <Style TargetType="ContentPresenter">
                                                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                                        </Style>
                                                                    </ItemsControl.ItemContainerStyle>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type models:TextSelectionRect}">
                                                                            <Rectangle Width="{Binding Width}"
                                                                                       Height="{Binding Height}"
                                                                                       Fill="#6690C8FF" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <ItemsControl ItemsSource="{Binding RightPage.SearchRects}"
                                                                              IsHitTestVisible="False">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <Canvas />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemContainerStyle>
                                                                        <Style TargetType="ContentPresenter">
                                                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                                        </Style>
                                                                    </ItemsControl.ItemContainerStyle>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type models:TextSelectionRect}">
                                                                            <Rectangle Width="{Binding Width}"
                                                                                       Height="{Binding Height}"
                                                                                       Fill="#66F4D35E" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Canvas>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </DockPanel>
        </Border>
    </Border>
</Window>
